CREATE DATABASE student_new;

USE student_new;

CREATE TABLE student (
    roll_no INT PRIMARY KEY,
    student_name VARCHAR(50) NOT NULL,
    student_city VARCHAR(10) NOT NULL,
    mark INT NOT NULL
);

